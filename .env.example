# Copy to .env.local. Local values are printed by `pnpm exec supabase status -o env`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=sb_secret_xxx
# Used only by scripts (seed, backup, tests). Not needed on Vercel.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
MAILPIT_URL=http://127.0.0.1:54324
# Optional: base URL for media files (defaults to same origin /media). Lets media hosting be replaced.
NEXT_PUBLIC_MEDIA_BASE_URL=
